{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magister Grades",
  "version": "0.1.0",
  "identifier": "app.magistergrades.desktop",
  "build": {
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Magister Grades", "width": 960, "height": 720 }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
