{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magister Grades",
  "version": "0.1.0",
  "identifier": "app.magistergrades.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Magister Grades", "width": 960, "height": 720 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.png"]
  }
}
